# Local development placeholders only. Copy to infra/.env and change the password.
# Do not commit infra/.env or any real credentials.

POSTGRES_USER=streamforge
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=streamforge
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
SERVER_PORT=8080
# Local API bind. Set SERVER_ADDRESS=0.0.0.0 only when a container or cloud host must accept non-loopback traffic.
SERVER_ADDRESS=127.0.0.1

# Local API keys. Startup rejects blank, short, identical, or unresolved values.
# Generate each with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Put the real values only in the gitignored infra/.env. These placeholders cannot start the API.
DEVICE_ADMIN_API_KEY=change-me
INGESTION_API_KEY=change-me

# Leave false unless this database should publish its pending outbox rows, including older ones.
OUTBOX_PUBLISHER_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9094
