# Copy to infra/.env.demo and replace every value. infra/.env.demo is gitignored.
# These placeholders are not credentials and are too short to start the API.

POSTGRES_USER=streamforge
POSTGRES_PASSWORD=change-me-demo-only
POSTGRES_DB=streamforge

# Generate two different values, each at least 32 characters:
# python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
DEVICE_ADMIN_API_KEY=change-me
INGESTION_API_KEY=change-me

DEMO_WEB_PORT=4173
DEMO_API_PORT=18080
